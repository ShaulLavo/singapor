{
  "name": "@singapor/example-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsgo && vite build",
    "test": "vitest run --browser.enabled --browser.headless",
    "test:e2e": "playwright test",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@singapor/core": "workspace:*",
    "@singapor/diff": "workspace:*",
    "@singapor/find": "workspace:*",
    "@singapor/gutters": "workspace:*",
    "@singapor/minimap": "workspace:*",
    "@singapor/scope-lines": "workspace:*",
    "@singapor/tree-sitter-languages": "workspace:*",
    "@singapor/typescript-lsp": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@typescript/native-preview": "7.0.0-dev.20260613.1",
    "@vitest/browser-playwright": "^4.1.8",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "typescript": "~6.0.3",
    "vite": "8.0.16",
    "vitest": "^4.1.8"
  }
}
