    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapor/core": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260524.1",
    "happy-dom": "^20.10.3",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@singapor/core": "workspace:*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
