{
  "name": "@singapor/react",
  "version": "0.1.1",
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapor/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@shikijs/langs": "4.2.0",
    "@shikijs/themes": "4.2.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260613.1",
    "@vitest/browser-playwright": "^4.1.8",
    "happy-dom": "^20.10.3",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tree-sitter-typescript": "^0.23.2",
    "typescript": "~6.0.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@singapor/core": "workspace:*",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
