{
  "name": "@singapor/typescript-lsp",
  "version": "0.1.1",
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./ts-diagnostics": {
      "types": "./dist/tsDiagnostics.d.ts",
      "import": "./dist/tsDiagnostics.js",
      "default": "./dist/tsDiagnostics.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapor/lsp": "workspace:*",
    "@singapor/lsp-plugin": "workspace:*",
    "@typescript/vfs": "^1.6.4",
    "typescript": "~5.9.3",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@singapor/core": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260524.1",
    "happy-dom": "^20.8.9",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "@singapor/core": "workspace:*"
  }
}
