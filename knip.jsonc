{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["**/*.d.css.ts"],
  // These deps are real but referenced in ways knip can't statically see, so they'd
  // otherwise show up as false-positive "unused dependencies":
  //   @phosphor-icons/web                         -> CSS `@import` in find/src/style.css
  //   @tree-sitter-grammars/tree-sitter-markdown  -> grammar source compiled by build:markdown-wasm
  //   tree-sitter-cli                             -> provides the `tree-sitter` binary that script spawns
  //   @playwright/test                            -> required by @vitest/browser's `playwright` provider
  "ignoreDependencies": [
    "@phosphor-icons/web",
    "@tree-sitter-grammars/tree-sitter-markdown",
    "tree-sitter-cli",
    "@playwright/test"
  ],
  // Each package builds its public surface from the `exports` map (build-package.ts maps
  // ./dist/X.js -> ./src/X.ts), so every exports entry point is registered here. Everything
  // reachable from these is "used"; anything else is genuinely internal dead code.
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs}"],
      "project": "scripts/**/*.{ts,mjs}"
    },
    "packages/editor": {
      "entry": [
        "src/index.ts",
        "src/debug.ts",
        "src/editor.ts",
        "src/internal.ts",
        "src/public/document.ts",
        "src/public/extensions.ts",
        "src/public/rendering.ts",
        "src/public/secondaryViews.ts",
        "src/public/syntax.ts",
        "src/public/testing.ts",
        "src/logging/index.ts",
        "src/logging/evlog.ts",
        "src/shiki/index.ts",
        "src/**/*.worker.ts",
        "bench/**/*.ts"
      ],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/markdown": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/gutters": {
      "entry": ["src/index.ts", "src/lineGutter.ts", "src/foldGutter.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/lsp": {
      "entry": ["src/index.ts", "src/positions.ts", "src/types.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/lsp-plugin": {
      "entry": [
        "src/index.ts",
        "src/completion.ts",
        "src/completionController.ts",
        "src/definitionNavigation.ts",
        "src/diagnostics.ts",
        "src/diagnosticsPresenter.ts",
        "src/documentSync.ts",
        "src/hoverDefinitionController.ts",
        "src/markdownTooltip.ts",
        "src/paths.ts",
        "src/pluginTypes.ts",
        "src/plugin.styles.ts",
        "src/tooltip.ts",
        "src/websocket.ts"
      ],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/typescript-lsp": {
      "entry": ["src/index.ts", "src/server.ts", "src/tsDiagnostics.ts", "src/**/*.worker.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/tree-sitter": {
      "entry": ["src/index.ts", "src/**/*.worker.ts", "bench/**/*.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/minimap": {
      "entry": ["src/index.ts", "src/**/*.worker.ts", "bench/**/*.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": "src/**/*.{ts,tsx}"
    },
    "examples/app": {
      "entry": ["index.html"],
      "project": "src/**/*.{ts,tsx}"
    }
  }
}
