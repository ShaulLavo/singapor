{
  "name": "@singapore-editor/tree-sitter",
  "version": "0.1.1",
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "bench:syntax": "bun bench/treeSitter-syntax.ts",
    "test": "vitest run",
    "test:browser": "vitest run --browser.enabled --browser.headless test/treeSitter-workerClient.browser.test.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapore-editor/core": "workspace:*",
    "web-tree-sitter": "^0.26.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^25.9.6",
    "@typescript/native-preview": "7.0.0-dev.20260613.1",
    "@vitest/browser-playwright": "^4.1.11",
    "happy-dom": "^20.14.5",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@singapore-editor/core": "workspace:*"
  }
}
