{
  "name": "@singapor/minimap",
  "version": "0.1.1",
  "files": [
    "README.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "sideEffects": [
    "./src/style.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./style.css": "./src/style.css"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "bench:update": "bun bench/update.ts",
    "test": "vitest run",
    "test:browser": "vitest run --browser.enabled --browser.headless test/workerClient.browser.test.ts",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapor/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@typescript/native-preview": "7.0.0-dev.20260524.1",
    "@vitest/browser": "^3.2.4",
    "happy-dom": "^20.8.9",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "typescript": "~5.9.3",
    "vitest": "^3.1.1"
  }
}
