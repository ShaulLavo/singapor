{
  "name": "@singapor/lsp-plugin",
  "version": "0.1.1",
  "files": [
    "README.md",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./completion": "./src/completion.ts",
    "./completion-controller": "./src/completionController.ts",
    "./definition-navigation": "./src/definitionNavigation.ts",
    "./diagnostics": "./src/diagnostics.ts",
    "./diagnostics-presenter": "./src/diagnosticsPresenter.ts",
    "./document-sync": "./src/documentSync.ts",
    "./hover-definition-controller": "./src/hoverDefinitionController.ts",
    "./markdown-tooltip": "./src/markdownTooltip.ts",
    "./paths": "./src/paths.ts",
    "./plugin-types": "./src/pluginTypes.ts",
    "./plugin-styles": "./src/plugin.styles.ts",
    "./tooltip": "./src/tooltip.ts",
    "./websocket": "./src/websocket.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapor/lsp": "workspace:*",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "unified": "^11.0.5",
    "vscode-languageserver-protocol": "^3.17.5"
  },
  "devDependencies": {
    "@singapor/core": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260524.1",
    "happy-dom": "^20.8.9",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "typescript": "~5.9.3",
    "vitest": "^3.1.1"
  },
  "peerDependencies": {
    "@singapor/core": "workspace:*"
  }
}
