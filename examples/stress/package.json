{
  "name": "@singapor/stress",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "node run.mjs",
    "bench:hidden": "node hidden.mjs",
    "bench:first-paint": "node first-paint.mjs",
    "fixtures": "node fixtures.mjs",
    "first-paint:proof": "node test/verify-first-paint.mjs results/first-paint",
    "compare": "node compare.mjs",
    "profile:summary": "node profile-summary.mjs",
    "profile:input": "node profile-input-layout.mjs",
    "test": "vitest run",
    "proof": "node test/verify-results.mjs results",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "bench:input": "node run.mjs --suite input-latency",
    "input:compare": "node input-compare.mjs",
    "input:proof": "node test/verify-input-results.mjs results/input-latency"
  },
  "dependencies": {
    "@singapor/core": "workspace:*",
    "@singapor/find": "workspace:*",
    "@singapor/tree-sitter": "workspace:*",
    "@singapor/tree-sitter-languages": "workspace:*",
    "evlog": "^2.19.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@typescript/native-preview": "7.0.0-dev.20260613.1",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "vite": "8.0.16",
    "vitest": "^4.1.8"
  }
}
