{
  "name": "@singapor/tree-sitter-languages",
  "version": "0.1.1",
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "bun ../../scripts/build-package.ts",
    "build:markdown-wasm": "node scripts/build-markdown-wasm.mjs",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapor/tree-sitter": "workspace:*",
    "@tree-sitter-grammars/tree-sitter-markdown": "^0.3.2",
    "tree-sitter-css": "^0.25.0",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-typescript": "^0.23.2"
  },
  "devDependencies": {
    "@singapor/core": "workspace:*",
    "@typescript/native-preview": "7.0.0-dev.20260524.1",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "tree-sitter-cli": "^0.23.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@singapor/core": "workspace:*",
    "@singapor/tree-sitter": "workspace:*"
  }
}
