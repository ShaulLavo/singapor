{
  "name": "@singapore-editor/typescript-lsp",
  "version": "0.1.1",
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    },
    "./ts-diagnostics": {
      "types": "./dist/tsDiagnostics.d.ts",
      "import": "./dist/tsDiagnostics.js",
      "default": "./dist/tsDiagnostics.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "bench:semantic-classification": "bun bench/semanticClassification.ts",
    "build": "bun ../../scripts/build-package.ts",
    "test": "vitest run",
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@singapore-editor/lsp": "workspace:*",
    "@singapore-editor/lsp-plugin": "workspace:*",
    "@typescript/vfs": "^1.6.4",
    "typescript": "~6.0.3",
    "vscode-languageserver-protocol": "^3.18.3"
  },
  "devDependencies": {
    "@singapore-editor/core": "workspace:*",
    "@types/node": "^25.9.6",
    "@typescript/native-preview": "7.0.0-dev.20260613.1",
    "happy-dom": "^20.14.5",
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@singapore-editor/core": "workspace:*"
  }
}
