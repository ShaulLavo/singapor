{
	"name": "editor-workspace",
	"private": true,
	"packageManager": "bun@1.3.10",
	"workspaces": [
		"packages/*",
		"examples/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"typecheck": "turbo typecheck",
		"lint": "turbo lint",
		"format": "turbo format",
		"format:check": "turbo format:check",
		"health": "bun scripts/architecture-health.mjs",
		"health:write": "bun scripts/architecture-health.mjs --write",
		"publish:packages": "bun scripts/publish-packages.ts",
		"publish:packages:dry-run": "bun scripts/publish-packages.ts --dry-run",
		"test": "turbo test"
	},
	"devDependencies": {
		"knip": "^6.16.1",
		"turbo": "^2.9.18",
		"typescript": "~5.9.3",
		"vite": "8.0.16"
	}
}
